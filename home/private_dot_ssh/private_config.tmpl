Host github.com
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  {{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
  {{- end }}
  Preferredauthentications publickey
  IdentityFile ~/.ssh/{{ if .personalMachine }}pers{{ else }}work{{ end }}

Host homeassistant
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  User root
  {{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
  {{- end }}
  Preferredauthentications publickey
  IdentityFile ~/.ssh/{{ if .personalMachine }}pers{{ else }}work{{ end }}

{{- if not .personalMachine }}
Host gerrit.mcp.mirantis.com
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  Preferredauthentications publickey
  IdentityFile ~/.ssh/work
  Port 29418
{{- end }}

Host *
  StrictHostKeyChecking accept-new
  HashKnownHosts yes
  ServerAliveInterval 600
  TCPKeepAlive yes
  IPQoS=throughput
  SetEnv TERM=xterm-256color
