#!/usr/bin/env bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "brew is required but not installed" >&2
  exit 1
fi

if ! command -v age >/dev/null 2>&1; then
  brew install age
fi

key_dir="$HOME/.config/chezmoi"
key_file="$key_dir/key.txt"

umask 077
mkdir -p "$key_dir"
chmod 700 "$key_dir"

if [[ ! -f "$key_file" ]]; then
  chezmoi age decrypt --output "$key_file" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
fi

chmod 600 "$key_file"
