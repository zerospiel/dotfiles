#!/usr/bin/env bash
set -euo pipefail

key_dir="$HOME/.config/chezmoi"
key_file="$key_dir/key.txt"

umask 077
mkdir -p "$key_dir"
chmod 700 "$key_dir"

if [[ ! -s "$key_file" ]]; then
  if ! command -v age >/dev/null 2>&1; then
    brew install age
  fi
  tmp_key="$(mktemp "$key_dir/.key.txt.XXXXXX")"
  trap 'rm -f "$tmp_key"' EXIT
  chezmoi age decrypt --output "$tmp_key" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
  mv "$tmp_key" "$key_file"
fi

chmod 600 "$key_file"
