{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/chezmoi/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/containers/auth.json)",
      "Bash(chezmoi cat *)",
      "Bash(chezmoi decrypt *)",
      "Bash(chezmoi age *)"
    ],
    "ask": [
      "Bash(chezmoi apply *)",
      "Bash(chezmoi update *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "podman *",
      "go get *",
      "go mod *",
      "gh *",
      "git fetch *",
      "git pull *",
      "git push *",
      "git commit *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/go",
        "~/Library/Caches"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "vuln.go.dev",
        "registry.npmjs.org"
      ]
    }
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "cleanupPeriodDays": 14,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enableArtifact": false,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "update-config": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "schedule": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only"
  }
}