getip() {
  dig TXT -4 +short o-o.myaddr.l.google.com @ns1.google.com | tr -d '"'
}

get_branch() {
  git branch 2>/dev/null | sed -e '/^[^*]/d ; s/* \(.*\)/(\1) /'
}

qq() {
  clear

  logpath="$TMPDIR/q"
  if [[ -z "$TMPDIR" ]]; then
    logpath="/tmp/q"
  fi

  if [[ ! -f "$logpath" ]]; then
    echo 'Q LOG' >"$logpath"
  fi

  tail -100f -- "$logpath"
}

rmqq() {
  logpath="$TMPDIR/q"
  if [[ -z "$TMPDIR" ]]; then
    logpath="/tmp/q"
  fi
  if [[ -f "$logpath" ]]; then
    rm "$logpath"
  fi
  qq
}

ghpull() {
  if [ ${#@} -gt 0 ]; then
    local pr_num=${1}
    local stream=${2:-upstream}
    printf "Fetching PR #%s from the %s remote\n" "$pr_num" "$stream"
    git fetch "$stream" pull/"$pr_num"/head && git checkout FETCH_HEAD
  fi
}
