{{- if not .personalMachine }}
export AWS_REGION=eu-central-1
export CONTAINER_TOOL=podman
export GOPRIVATE=gerrit.mcp.mirantis.com,github.com/Mirantis,github.com/k0rdent/k0rdent-enterprise
{{- end }}

# golang related envs
export GOPATH=$HOME/go
# export GOROOT=$(brew --prefix go@1.12)/libexec
# export GOROOT=/usr/local/go
export GOBIN=$GOPATH/bin
export GONOPROXY="${GOPRIVATE:-}"
export GONOSUMDB="${GOPRIVATE:-}"
{{- $chain := list }}
{{- if not .personalMachine }}
  {{- $chain = append $chain "https://artifactory.mcp.mirantis.net/artifactory/api/go/go" }}
{{- end }}
{{- $chain = uniq (compact (concat $chain (list "https://proxy.golang.org" "direct"))) }}
export GOPROXY="{{ join "|" $chain }}"
export GOSUMDB=sum.golang.org
export GO111MODULE=on
export GOINSECURE=none
export GOVULNDB=https://vuln.go.dev

# csharp related envs
export DOTNET_CLI_TELEMETRY_OPTOUT=0

# give existing tool directories priority and preserve the remaining inherited path
for path_entry in /usr/local/go/bin "$GOBIN" /opt/homebrew/sbin /opt/homebrew/bin /opt/homebrew/opt/gnu-sed/libexec/gnubin; do
  [[ -d "$path_entry" ]] || continue
  path_tail="${PATH+:$PATH:}"
  while [[ "$path_tail" == *":$path_entry:"* ]]; do
    path_tail="${path_tail/":$path_entry:"/:}"
  done
  if [[ -z "$path_tail" || "$path_tail" == : ]]; then
    PATH="$path_entry"
  else
    path_tail="${path_tail#:}"
    path_tail="${path_tail%:}"
    PATH="$path_entry:$path_tail"
  fi
done
export PATH
unset path_entry path_tail

# other related envs
export LC_ALL='en_US.UTF-8'
export LANG=$LC_ALL
export LC_TIME=$LC_ALL
export LC_COLLATE=$LC_ALL
export LC_CTYPE=$LC_ALL
# shellcheck disable=SC2155
export PS1="\[\033[38;5;5m\]\W\[$(tput sgr0)\]\[\033[38;5;15m\] \[$(tput sgr0)\]\[\033[38;5;10m\]\\$\[$(tput sgr0)\]\[\033[38;5;15m\]\[$(tput sgr0)\] \[\033[38;5;14m\]\$(get_branch)\[$(tput sgr0)\]"
export CLICOLOR=1
export LSCOLORS=Gxfxcxdxbxegedabagacad
{{- if eq .chezmoi.os "darwin" }}
export BASH_SILENCE_DEPRECATION_WARNING=1
{{- end }}
export EDITOR='vim'
export KIND_EXPERIMENTAL_PROVIDER='podman'
export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1
export HOMEBREW_NO_ASK=1

# history
export HISTFILESIZE=1000000
export HISTSIZE=1000000
export HISTCONTROL="ignoreboth:erasedups"
